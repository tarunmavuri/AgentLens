# AgentLens Environment Configuration
# Copy this file to .env and configure your keys

# Google Gemini API Key (Required for live Gemini model executions)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Tavily Web Search API Key (Optional: fallbacks to DuckDuckGo/simulated search if empty)
# Get a key from: https://tavily.com/
TAVILY_API_KEY=

# Default LLM Model
DEFAULT_MODEL=gemini-2.5-flash

# SQLite Database File Path
DB_PATH=agentlens.db


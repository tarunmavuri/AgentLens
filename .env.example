# AgentLens backend configuration
# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Leave empty to run deterministic offline simulation (clearly labelled in traces).
GEMINI_API_KEY=

# Comma-separated allowlist. Users/custom agents may only select these models.
ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite

# Tried in order when the requested model is unavailable (404), out of quota
# (429) or overloaded (503) after normal retries. Usage records the model that
# actually answered.
MODEL_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash

DEFAULT_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_REPAIR_ATTEMPTS=1
ALLOW_OFFLINE_SIMULATION=true

# Optional JSON override of the built-in price table ($ per million tokens):
# MODEL_PRICING_JSON={"gemini-3-flash-preview":{"input_cost_per_million":0.3,"output_cost_per_million":2.5}}

# --- Search -------------------------------------------------------------------
# Optional Tavily key; falls back to DuckDuckGo HTML/instant answers.
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=8

# --- Storage ------------------------------------------------------------------
# SQLite file path. On hosted platforms this must be on a persistent disk.
DB_PATH=agentlens.db

# --- Cloudflare Access Authentication (Server) --------------------------------
# Your Cloudflare Zero Trust team domain, e.g. https://myteam.cloudflareaccess.com
CLOUDFLARE_TEAM_DOMAIN=
# Application Audience (AUD) tag from Cloudflare Zero Trust -> Access -> Applications
CLOUDFLARE_ACCESS_AUD=
# In local development without Cloudflare Access, set true to use a local dev identity.
# Automatically defaults to false when APP_ENV=production.
ALLOW_LOCAL_DEV_AUTH=true
LOCAL_DEV_USER_ID=local-dev-user
LOCAL_DEV_USER_EMAIL=developer@localhost

# --- HTTP ---------------------------------------------------------------------
APP_ENV=development
# Comma-separated allowed browser origins. Use explicit origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Sandbox and guardrails ---------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MAX_OUTPUT_CHARS=10000
MAX_STEPS_DEFAULT=25
MAX_TOKENS_DEFAULT=60000
MAX_SECONDS_DEFAULT=300
MAX_RETRIES_DEFAULT=2

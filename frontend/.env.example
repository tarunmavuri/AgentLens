# Leave empty in development: Vite proxies /runs, /agents, /tools, /config,
# /concepts and /health to http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_URL=

# On Vercel, point this at the deployed backend (Render), e.g.
# VITE_API_URL=https://agentlens-backend.onrender.com

# --- Firebase Authentication (Public Web Client Config) -----------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
